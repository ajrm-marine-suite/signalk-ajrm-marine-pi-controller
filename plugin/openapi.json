{
  "openapi": "3.1.0",
  "info": {
    "title": "AJRM Marine Pi Controller API",
    "version": "0.7.2",
    "description": "Read Raspberry Pi health and request explicitly enabled host support actions."
  },
  "servers": [{ "url": "/plugins/signalk-ajrm-marine-pi-controller" }],
  "paths": {
    "/status": {
      "get": {
        "summary": "Read host and controller status",
        "responses": { "200": { "$ref": "#/components/responses/Ok" }, "500": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/actions/reboot": { "$ref": "#/components/pathItems/Action" },
    "/actions/shutdown": { "$ref": "#/components/pathItems/Action" },
    "/actions/install-piper": { "$ref": "#/components/pathItems/Action" },
    "/actions/backup-sd-card": { "$ref": "#/components/pathItems/Action" }
  },
  "components": {
    "securitySchemes": { "signalk": { "type": "http", "scheme": "bearer" } },
    "pathItems": {
      "Action": {
        "post": {
          "summary": "Run one confirmed host action",
          "security": [{ "signalk": ["readwrite"] }],
          "responses": {
            "200": { "$ref": "#/components/responses/Ok" },
            "202": { "$ref": "#/components/responses/Ok" },
            "400": { "$ref": "#/components/responses/Error" },
            "403": { "$ref": "#/components/responses/Forbidden" },
            "409": { "$ref": "#/components/responses/Error" },
            "500": { "$ref": "#/components/responses/Error" }
          }
        }
      }
    },
    "responses": {
      "Ok": { "description": "Successful response" },
      "Forbidden": { "description": "Signal K read/write or administrator access required" },
      "Error": { "description": "Operation failed" }
    }
  }
}
